      },
      "expected_behavior": {
        "type": "string",
        "nullable": true
      },
      "understanding_source": {
        "type": "string",
        "enum": [
          "user-report",
          "repository-evidence",
          "user-answer",
          "unresolved"
        ]
      },
      "understanding_source_ids": {
        "type": "array",
