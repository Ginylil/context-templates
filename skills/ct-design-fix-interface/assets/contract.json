  "rules": [
    {
      "type": "equals-input",
      "field": "candidate_revision",
      "input_field": "candidate_revision"
    },
    {
      "type": "repository-revision",
      "field": "candidate_revision"
    },
    {
      "type": "command",
      "field": "before_check",
      "exit": "nonzero"
    },
    {
      "type": "command",
      "field": "after_check",
      "exit": "zero"
    },
    {
      "type": "command",
      "field": "related_check",
      "exit": "zero"
    },
    {
      "type": "command",
      "field": "build_check",
      "exit": "zero"
    },
    {
      "type": "same-command",
      "fields": [
        "before_check",
        "after_check"
      ]
    },
    {
      "type": "command-matches-input",
      "field": "before_check",
      "input_field": "reproduction_argv"
    },
    {
      "type": "interface-fix"
    }
  ]
}
