          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "min_items": 0
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "min_items": 0
          },
          "additional_searches": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "min_items": 0
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "fields": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            },
            "min_items": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "min_items": 1
          }
        }
      },
      "occurrences": {
        "type": "array",
        "items": {
          "type": "object",
          "fields": {
            "id": {
